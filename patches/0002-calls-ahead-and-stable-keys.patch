+        self, run_id: str, items: list[dict[str, JsonValue]], events: list[HostEvent]
+    ) -> None:
+        """What a run added so far, in its lane before its commit: an unfenced commit, as
+        ``cancel`` makes, of the items as upserts on their ids, which the run's own commit
